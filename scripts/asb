#!/bin/sh
# ASB Linux launcher. Keep Node discovery independent of the desktop PATH.
set -eu
PATH="${PATH:-}:/usr/local/bin:/usr/bin:/bin"
export PATH
ASB_ROOT=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
ASB_PACKAGE_COMMAND=
if [ "${1:-}" = --package ]; then ASB_PACKAGE_COMMAND="${2:-}"; fi
case "${1:-}" in agent|doctor|group|network|phone|usage|setup) ASB_PACKAGE_COMMAND="$1" ;; esac
for ASB_CANDIDATE in "${ASB_NODE:-}" "$(command -v node || true)" "$HOME/.local/bin/node" /home/linuxbrew/.linuxbrew/bin/node /usr/local/bin/node /usr/bin/node; do
  if [ -n "$ASB_CANDIDATE" ] && [ -x "$ASB_CANDIDATE" ] && "$ASB_CANDIDATE" --input-type=module -e 'if (Number(process.versions.node.split(".")[0]) < 20) process.exit(1); if (!["build","uninstall","agent","doctor","group","network","phone","usage","setup"].includes(process.argv[1])) { try { await import("node:sqlite"); } catch { const {execFileSync}=await import("node:child_process"); execFileSync("sqlite3",["--version"],{stdio:"ignore"}); } }' "$ASB_PACKAGE_COMMAND" >/dev/null 2>&1; then
    export ASB_NODE="$ASB_CANDIDATE"
    # The engine (the user service runs `service run`) gets a smaller V8 young generation and the glibc settings that return freed memory
    # (src/memory-trim.mjs). glibc reads them at start, so they cannot come later. A setting that the user set (also to an empty value) stays.
    # The engine removes the ASB values from its own environment.
    if [ "$*" = "service run" ] || [ "$*" = "engine run" ]; then
      export MALLOC_ARENA_MAX="${MALLOC_ARENA_MAX-2}" MALLOC_MMAP_THRESHOLD_="${MALLOC_MMAP_THRESHOLD_-131072}" MALLOC_TRIM_THRESHOLD_="${MALLOC_TRIM_THRESHOLD_-131072}"
      exec "$ASB_CANDIDATE" --max-semi-space-size=16 "$ASB_ROOT/scripts/asb.mjs" "$@"
    fi
    # One dispatcher for every command (scripts/asb.mjs).
    exec "$ASB_CANDIDATE" "$ASB_ROOT/scripts/asb.mjs" "$@"
  fi
done
printf '%s\n' 'ASB needs Node.js 20 or later and built-in SQLite or the sqlite3 command. Node.js 22.13 or later is recommended. Set ASB_NODE to its absolute executable path. Install help: https://github.com/Jamir-boop/ASB#nodejs' >&2
exit 1
