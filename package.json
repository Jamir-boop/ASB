{
  "name": "agent-switch-board",
  "description": "Local sidebar for existing Codex and Claude Desktop Code sessions.",
  "version": "1.6.0",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "agent",
    "codex",
    "claude"
  ],
  "scripts": {
    "start": "node src/switchboard.mjs",
    "test": "node --test",
    "desktop": "node scripts/asb-desktop.mjs",
    "build": "node scripts/asb-package.mjs build",
    "install:user": "node scripts/asb-package.mjs install",
    "uninstall:user": "node scripts/asb-package.mjs uninstall",
    "check:runtime": "node scripts/asb-package.mjs check",
    "test:native": "python3 -m unittest discover -s test -p asb_native_test.py -v"
  },
  "engines": {
    "node": ">=20"
  }
}
