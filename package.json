{
  "name": "agent-switch-board",
  "description": "Local sidebar for existing Codex and Claude Desktop Code sessions.",
  "version": "1.12.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "asb": "scripts/asb.mjs"
  },
  "files": [
    "src/",
    "scripts/*.mjs",
    "scripts/asb",
    "scripts/asb-board.py",
    "scripts/asb-native.py",
    "scripts/asb-tray.py",
    "scripts/asb-tray.ps1",
    "public/",
    "assets/",
    "bridge/dist/",
    "bridge/hooks/",
    "bridge/agent-skills/",
    "bridge/.codex-plugin/",
    "bridge/.mcp.json",
    "bridge/package.json",
    "bridge/LICENSE",
    "bridge/README.md",
    ".agents/plugins/marketplace.json",
    "LICENSE",
    "README.md",
    "install.sh",
    "uninstall.sh"
  ],
  "keywords": [
    "agent",
    "codex",
    "claude"
  ],
  "scripts": {
    "start": "node src/switchboard.mjs",
    "test": "node --test --no-experimental-strip-types",
    "desktop": "node scripts/asb-desktop.mjs",
    "build": "node scripts/asb-package.mjs build",
    "install:user": "node scripts/asb-package.mjs install",
    "uninstall:user": "node scripts/asb-package.mjs uninstall",
    "check:runtime": "node scripts/asb-package.mjs check",
    "test:native": "python3 -m unittest discover -s test -p asb_native_test.py -v"
  },
  "engines": {
    "node": ">=20"
  }
}
